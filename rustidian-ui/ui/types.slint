// Shared data structures used by the UI components.

export struct NoteItem {
    id: string,
    title: string,
    // Relative folder path within the vault (empty string for root-level notes)
    folder: string,
}

export struct BacklinkItem {
    id: string,
    title: string,
}

// A tab in the tab bar (one per open note)
export struct TabItem {
    id: string,
    title: string,
    unsaved: bool,
}

// ── Sidebar tree ─────────────────────────────────────────────────────────────

export enum TreeRowKind {
    folder,
    note,
}

// A single flattened row of the sidebar tree.  The tree itself is expanded into
// this flat model by Rust; `depth` drives the indentation and `expanded` is the
// persisted folder state.
export struct TreeRow {
    kind: TreeRowKind,
    depth: int,
    // For folders: relative folder path. For notes: the note id.
    id: string,
    // Display name (folder segment or note title).
    name: string,
    // Notes only: relative parent folder (empty for root).
    folder: string,
    // Folders only.
    expanded: bool,
    has-children: bool,
    is-selected-folder: bool,
}

// ── Link activation ──────────────────────────────────────────────────────────

// Emitted when the user clicks a link in the preview.  Wikilinks carry the
// `rustidian://` scheme and are resolved by Rust; other URLs are opened with
// `Platform.open-url` directly in Slint.
export global Links {
    callback activated(string);
}

// ── Drag & drop ──────────────────────────────────────────────────────────────

// Dragging a note carries its id as a `data-transfer` (plain text).  Data
// transfers are opaque to Slint, so the conversions are implemented in Rust.
export global Dnd {
    // Build the payload for a note drag from its id.
    pure callback note-transfer(string) -> data-transfer;
    // Read back the note id from a payload ("" when it carries none).
    pure callback transfer-note(data-transfer) -> string;
    // Whether a payload looks like a note id (used for drop highlighting).
    pure callback can-drop-note(data-transfer) -> bool;
}

// ── Markdown preview ─────────────────────────────────────────────────────────

export enum BlockKind {
    heading,
    paragraph,
    list-item,
    task-item,
    code,
    quote,
    table,
    rule,
}

// One rendered Markdown block.  `markup` is pre-parsed by Rust into a
// `styled-text` so Slint can render bold/italic/links/inline code natively.
export struct BlockItem {
    kind: BlockKind,
    // Heading level (1-6) for `heading`, otherwise unused.
    level: int,
    // Nesting depth for list items and block quotes.
    indent: int,
    // Inline content as StyledText markup (heading/paragraph/list/quote).
    markup: styled-text,
    // Code blocks.
    lang: string,
    code: string,
    // Lists.
    ordered: bool,
    marker: string,
    // Task items.
    checked: bool,
    // Tables: cells in row-major order (header row first) and column count.
    cells: [string],
    columns: int,
}

// ── Editor assistance ────────────────────────────────────────────────────────

// Result of intercepting a key press in the Markdown editor.
export struct EditResult {
    handled: bool,
    text: string,
    cursor: int,
    anchor: int,
}
