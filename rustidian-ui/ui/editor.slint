import { ScrollView } from "std-widgets.slint";
import { Palette } from "theme.slint";
import { EditResult } from "types.slint";

// Markdown editor built on the low-level `TextInput` so we have access to the
// cursor/anchor byte offsets needed for the editing assistance.
export component Editor inherits Rectangle {
    background: Palette.bg;

    in-out property <string> content: "";
    in property <[string]> note-titles: [];
    in-out property <[string]> suggestions: [];
    in-out property <bool> show-suggestions: false;
    // When set to a non-empty string, it is spliced in at the caret (via
    // `request-insert`) and then cleared.  Used to insert images.
    in-out property <string> pending-insert: "";
    // Exposed cursor/anchor for context menu and formatting.
    in-out property <int> cursor-pos: 0;
    in-out property <int> anchor-pos: 0;

    callback content-changed(string);
    // (key-text, ctrl, shift, alt, content, cursor, anchor) -> result
    callback handle-edit-key(string, bool, bool, bool, string, int, int) -> EditResult;
    // (title, content, cursor) -> result
    callback accept-suggestion(string, string, int) -> EditResult;
    callback update-suggestions(string, int);
    // (insert-text, content, cursor) -> result — splice text at the caret.
    callback request-insert(string, string, int) -> EditResult;
    // Format selection with bold/italic/code/codeblock (kind, content, cursor, anchor) -> result
    callback format-selection(string, string, int, int) -> EditResult;
    // A drag-and-drop payload was dropped on the editor (may carry files).
    callback files-dropped(data-transfer);
    // Paste image from clipboard: returns markdown to insert at cursor, or empty if no image.
    callback paste-image-requested(string, int) -> EditResult;

    changed pending-insert => {
        if (root.pending-insert != "") {
            let res = root.request-insert(
                root.pending-insert,
                input.text,
                input.cursor-position-byte-offset
            );
            if (res.handled) {
                input.text = res.text;
                input.set-selection-offsets(res.anchor, res.cursor);
                root.content-changed(input.text);
            }
            root.pending-insert = "";
        }
    }

    // Left border — visual separator
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }

    scroll := ScrollView {
        x: 1px;
        y: 0px;
        width: parent.width - 1px;
        height: parent.height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, input.preferred-height + 24px);

        input := TextInput {
            x: 12px;
            y: 12px;
            width: scroll.visible-width - 24px;
            wrap: word-wrap;
            font-size: 14px;
            font-family: "monospace";
            color: Palette.text;
            single-line: false;
            selection-background-color: Palette.accent;
            selection-foreground-color: Palette.bg;
            text <=> root.content;

            // Keep cursor/anchor properties in sync for context menu access.
            edited => {
                root.cursor-pos = self.cursor-position-byte-offset;
                root.anchor-pos = self.anchor-position-byte-offset;
                root.content-changed(self.text);
                root.update-suggestions(self.text, self.cursor-position-byte-offset);
            }

            key-pressed(event) => {
                // ── Formatting shortcuts ──────────────────────────────────
                if (event.modifiers.control && !event.modifiers.alt && event.text == "b") {
                    let res = root.format-selection(
                        "bold",
                        self.text,
                        self.cursor-position-byte-offset,
                        self.anchor-position-byte-offset
                    );
                    if (res.handled) {
                        self.text = res.text;
                        self.set-selection-offsets(res.anchor, res.cursor);
                        root.content-changed(self.text);
                    }
                    return accept;
                }
                if (event.modifiers.control && !event.modifiers.alt && event.text == "i") {
                    let res = root.format-selection(
                        "italic",
                        self.text,
                        self.cursor-position-byte-offset,
                        self.anchor-position-byte-offset
                    );
                    if (res.handled) {
                        self.text = res.text;
                        self.set-selection-offsets(res.anchor, res.cursor);
                        root.content-changed(self.text);
                    }
                    return accept;
                }
                if (event.modifiers.control && event.modifiers.shift && (event.text == "K" || event.text == "k")) {
                    let res = root.format-selection(
                        "codeblock",
                        self.text,
                        self.cursor-position-byte-offset,
                        self.anchor-position-byte-offset
                    );
                    if (res.handled) {
                        self.text = res.text;
                        self.set-selection-offsets(res.anchor, res.cursor);
                        root.content-changed(self.text);
                    }
                    return accept;
                }
                // ── Ctrl+V: try paste image, then fall through ─────────
                if (event.modifiers.control && !event.modifiers.alt && (event.text == "v" || event.text == "V")) {
                    let res = root.paste-image-requested(self.text, self.cursor-position-byte-offset);
                    if (res.handled) {
                        self.text = res.text;
                        self.set-selection-offsets(res.anchor, res.cursor);
                        root.content-changed(self.text);
                        return accept;
                    }
                    // No image in clipboard — fall through to native paste
                }
                // ── Normal editing assistance ───────────────────────────
                if (!event.modifiers.control && !event.modifiers.alt && event.text != "") {
                    let res = root.handle-edit-key(
                        event.text,
                        event.modifiers.control,
                        event.modifiers.shift,
                        event.modifiers.alt,
                        self.text,
                        self.cursor-position-byte-offset,
                        self.anchor-position-byte-offset
                    );
                    if (res.handled) {
                        self.text = res.text;
                        self.set-selection-offsets(res.anchor, res.cursor);
                        root.content-changed(self.text);
                        root.update-suggestions(self.text, res.cursor);
                        return accept;
                    }
                }
                reject
            }
        }
    }

    // ── Drop images files straight into the note ─────────────────────────────
    drop-area := DropArea {
        width: parent.width;
        height: parent.height;
        can-drop(event) => { return DragAction.copy; }
        dropped(event) => {
            root.files-dropped(event.data);
            return DragAction.copy;
        }
    }

    // ── Right-click context menu ─────────────────────────────────────────────
    context-area := ContextMenuArea {
        width: parent.width;
        height: parent.height;

        Menu {
            MenuItem {
                title: "Copy";
                activated => { /* Slint TextInput handles Ctrl+C natively */ }
            }
            MenuItem {
                title: "Cut";
                activated => { /* Slint TextInput handles Ctrl+X natively */ }
            }
            MenuItem {
                title: "Paste";
                activated => { /* Slint TextInput handles Ctrl+V natively */ }
            }
            MenuSeparator { }
            MenuItem {
                title: "Bold";
                activated => {
                    let res = root.format-selection(
                        "bold",
                        root.content,
                        root.cursor-pos,
                        root.anchor-pos
                    );
                    if (res.handled) {
                        root.content = res.text;
                    }
                }
            }
            MenuItem {
                title: "Italic";
                activated => {
                    let res = root.format-selection(
                        "italic",
                        root.content,
                        root.cursor-pos,
                        root.anchor-pos
                    );
                    if (res.handled) {
                        root.content = res.text;
                    }
                }
            }
            MenuItem {
                title: "Inline Code";
                activated => {
                    let res = root.format-selection(
                        "code",
                        root.content,
                        root.cursor-pos,
                        root.anchor-pos
                    );
                    if (res.handled) {
                        root.content = res.text;
                    }
                }
            }
            MenuItem {
                title: "Code Block";
                activated => {
                    let res = root.format-selection(
                        "codeblock",
                        root.content,
                        root.cursor-pos,
                        root.anchor-pos
                    );
                    if (res.handled) {
                        root.content = res.text;
                    }
                }
            }
        }
    }

    // ── Wikilink completion popup ─────────────────────────────────────────────
    if root.show-suggestions && root.suggestions.length > 0: Rectangle {
        x: 16px;
        width: 260px;
        y: parent.height - self.height - 12px;
        height: min(root.suggestions.length, 8) * 24px + 8px;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 4px;
        clip: true;

        VerticalLayout {
            padding: 4px;
            spacing: 0px;

            for title in root.suggestions: Rectangle {
                height: 24px;
                background: suggestion-touch.has-hover ? Palette.card : transparent;
                border-radius: 3px;

                suggestion-touch := TouchArea {
                    clicked => {
                        let res = root.accept-suggestion(title, input.text, input.cursor-position-byte-offset);
                        if (res.handled) {
                            input.text = res.text;
                            input.set-selection-offsets(res.anchor, res.cursor);
                            root.content-changed(input.text);
                            root.update-suggestions(input.text, res.cursor);
                        }
                    }
                }

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: title;
                    color: Palette.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
