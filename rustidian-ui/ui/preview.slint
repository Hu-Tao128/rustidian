import { ScrollView } from "std-widgets.slint";
import { Palette } from "theme.slint";
import { BlockItem, BlockKind } from "types.slint";
import { HeadingBlock } from "heading.slint";
import { ParagraphBlock } from "paragraph.slint";
import { ListItemBlock } from "list_item.slint";
import { TaskItemBlock } from "task_item.slint";
import { CodeBlock } from "code_block.slint";
import { BlockQuoteBlock } from "block_quote.slint";
import { TableBlock } from "table_block.slint";
import { ThematicBreakBlock } from "thematic_break.slint";
import { ImageBlock } from "image_block.slint";

// Preview pane: renders the parsed Markdown block model with dedicated
// components per block kind.
export component Preview inherits Rectangle {
    background: Palette.surface;

    // Parsed Markdown blocks, produced by rustidian-core and bridged in Rust.
    in property <[BlockItem]> blocks: [];

    // A clickable image was activated (carries its absolute path).
    callback image-clicked(string);

    ScrollView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 32px;
            width: parent.width;
            spacing: 8px;

            if root.blocks.length == 0: Text {
                text: "Nothing to preview yet.\nStart typing in the editor.";
                color: Palette.text-muted;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            for block in root.blocks: VerticalLayout {
                spacing: 0px;

                if block.kind == BlockKind.heading: HeadingBlock {
                    markup: block.markup;
                    level: block.level;
                }

                if block.kind == BlockKind.paragraph: ParagraphBlock {
                    markup: block.markup;
                }

                if block.kind == BlockKind.list-item: ListItemBlock {
                    markup: block.markup;
                    marker: block.marker;
                    indent: block.indent;
                }

                if block.kind == BlockKind.task-item: TaskItemBlock {
                    markup: block.markup;
                    checked: block.checked;
                    indent: block.indent;
                }

                if block.kind == BlockKind.code: CodeBlock {
                    code: block.code;
                    lang: block.lang;
                }

                if block.kind == BlockKind.quote: BlockQuoteBlock {
                    markup: block.markup;
                    indent: block.indent;
                }

                if block.kind == BlockKind.table: TableBlock {
                    cells: block.cells;
                    columns: block.columns;
                }

                if block.kind == BlockKind.rule: ThematicBreakBlock { }

                if block.kind == BlockKind.image: ImageBlock {
                    source: block.image;
                    path: block.image-path;
                    alt: block.alt;
                    clicked(p) => { root.image-clicked(p); }
                }
            }
        }
    }
}
