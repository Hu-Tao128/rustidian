import { Palette } from "theme.slint";

// Renders a fenced/indented code block with a background and monospaced font.
export component CodeBlock inherits Rectangle {
    in property <string> code;
    in property <string> lang;

    background: Palette.card;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
    height: layout.preferred-height;

    layout := VerticalLayout {
        padding: 10px;
        spacing: 4px;

        if root.lang != "": Text {
            text: root.lang;
            color: Palette.text-muted;
            font-size: 11px;
            font-family: "monospace";
        }

        Text {
            text: root.code;
            color: Palette.text;
            font-size: 13px;
            font-family: "monospace";
            wrap: word-wrap;
        }
    }
}
