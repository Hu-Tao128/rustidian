import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";
import { NoteItem, BacklinkItem, TabItem, TreeRow, BlockItem, EditResult, Dnd, Links } from "types.slint";
import { Palette } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { Editor } from "editor.slint";
import { Preview } from "preview.slint";

export { NoteItem, BacklinkItem, TabItem, TreeRow, BlockItem, EditResult, Palette, Dnd, Links }

export enum StatusKind { info, success, error }

// View mode — mirrors Obsidian's editor/split/preview modes
export enum ViewMode { edit, split, preview }

export global AppState {
    in-out property <bool> graph-available: false;
    in-out property <bool> show-graph: false;
    in-out property <bool> unsaved: false;
    in-out property <string> status-message: "";
    in-out property <string> search-query: "";
}

export component AppWindow inherits Window {
    title: "Rustidian";
    min-width: 640px;
    min-height: 480px;
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Palette.bg;

    // ── public properties ────────────────────────────────────────────────────
    in-out property <[TreeRow]> tree: [];
    in property <int> note-count: 0;
    in-out property <string> current-note-id: "";
    in-out property <string> current-note-title: "";
    in-out property <string> current-note-content: "";
    in-out property <[BlockItem]> preview-blocks: [];
    in-out property <[BacklinkItem]> backlinks: [];
    in-out property <[NoteItem]> search-results: [];
    in-out property <bool> graph-available: false;
    in-out property <bool> unsaved: false;
    in-out property <string> status-message: "";
    in-out property <StatusKind> status-kind: StatusKind.info;

    // Wikilink completion
    in property <[string]> note-titles: [];
    in-out property <[string]> suggestions: [];
    in-out property <bool> show-suggestions: false;

    // Theme: true = Catppuccin Mocha (dark), false = Latte (light)
    in-out property <bool> dark-mode: true;

    // View mode: edit-only | split (editor + preview) | preview-only
    in-out property <ViewMode> view-mode: ViewMode.split;

    // Open tabs — each tab is an open note
    in-out property <[TabItem]> open-tabs: [];

    // When true the app shows the vault-picker screen instead of the main editor.
    in-out property <bool> show-vault-picker: false;
    in-out property <string> vault-picker-error: "";

    // ── callbacks ────────────────────────────────────────────────────────────
    callback note-selected(string);
    callback content-changed(string);
    callback save-requested();
    callback new-note-requested();
    callback new-folder-requested();
    callback rename-requested(string, string);
    callback rename-folder-requested(string, string);
    callback delete-requested(string);
    callback delete-folder-requested(string);
    // note-moved(note-id, target-folder) — a note was dropped onto a folder
    callback note-moved(string, string);
    callback search-changed(string);
    callback vault-open-requested(string);
    callback browse-vault-requested();
    callback folder-toggled(string);
    // toggle-preview kept for Ctrl+P backward compat — cycles view mode
    callback toggle-preview();
    callback toggle-theme();
    // tab-closed(id) — user clicked × on a tab
    callback tab-closed(string);

    // Markdown editing assistance (implemented in Rust, never in rustidian-core)
    callback handle-edit-key(string, bool, bool, bool, string, int, int) -> EditResult;
    callback accept-suggestion(string, string, int) -> EditResult;
    callback update-suggestions(string, int);

    // ── Vault picker screen ──────────────────────────────────────────────────
    if root.show-vault-picker: Rectangle {
        background: Palette.bg;

        VerticalBox {
            alignment: center;
            spacing: 16px;
            padding: 40px;

            Text {
                text: "Welcome to Rustidian";
                color: Palette.accent;
                font-size: 22px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: "Choose the folder where your notes are stored.";
                color: Palette.text-muted;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Button {
                text: "📂  Choose folder…";
                clicked => { root.browse-vault-requested(); }
            }

            if root.vault-picker-error != "": Text {
                text: root.vault-picker-error;
                color: Palette.danger;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: "Tip: you can also set the RUSTIDIAN_VAULT environment variable\nbefore launching to skip this screen.";
                color: Palette.text-muted;
                font-size: 11px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // ── Main editor layout ───────────────────────────────────────────────────
    if !root.show-vault-picker: HorizontalBox {
        padding: 0px;
        spacing: 0px;

        // Sidebar
        sidebar := Sidebar {
            min-width: 160px;
            preferred-width: 220px;
            horizontal-stretch: 0;
            tree: root.tree;
            note-count: root.note-count;
            search-results: root.search-results;
            backlinks: root.backlinks;
            current-note-id: root.current-note-id;
            graph-available: root.graph-available;
            note-selected(id) => { root.note-selected(id); }
            folder-toggled(path) => { root.folder-toggled(path); }
            new-note-requested() => { root.new-note-requested(); }
            new-folder-requested() => { root.new-folder-requested(); }
            delete-requested(id) => { root.delete-requested(id); }
            delete-folder-requested(path) => { root.delete-folder-requested(path); }
            note-moved(id, folder) => { root.note-moved(id, folder); }
            search-changed(q) => { root.search-changed(q); }
            vault-change-requested() => { root.browse-vault-requested(); }
            rename-requested(id, new-title) => { root.rename-requested(id, new-title); }
            rename-folder-requested(path, new-name) => { root.rename-folder-requested(path, new-name); }
        }

        // Main content column
        VerticalBox {
            horizontal-stretch: 1;
            padding: 0px;
            spacing: 0px;

            // ── Tab bar ──────────────────────────────────────────────────────
            Rectangle {
                height: root.open-tabs.length > 0 ? 36px : 0px;
                background: Palette.surface;
                clip: true;

                Rectangle {
                    height: 1px;
                    y: parent.height - 1px;
                    background: Palette.border;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 0px;
                    alignment: start;

                    for tab in root.open-tabs: Rectangle {
                        width: tab-inner.preferred-width + 32px;
                        height: parent.height;
                        background: tab.id == root.current-note-id ? Palette.card : transparent;

                        Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            width: parent.width;
                            background: tab.id == root.current-note-id ? Palette.accent : transparent;
                        }

                        tab-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { root.note-selected(tab.id); }
                        }

                        if tab-touch.has-hover && tab.id != root.current-note-id: Rectangle {
                            background: Palette.card;
                            width: parent.width;
                            height: parent.height;
                        }

                        HorizontalBox {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 4px;
                            alignment: center;

                            tab-inner := Text {
                                text: (tab.unsaved ? "● " : "") + tab.title;
                                color: tab.id == root.current-note-id ? Palette.text : Palette.text-muted;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 160px;
                            }

                            close-touch := TouchArea {
                                width: 18px;
                                height: 18px;
                                mouse-cursor: pointer;
                                clicked => { root.tab-closed(tab.id); }

                                Rectangle {
                                    background: close-touch.has-hover ? Palette.card : transparent;
                                    border-radius: 3px;
                                    width: parent.width;
                                    height: parent.height;

                                    Text {
                                        text: "×";
                                        color: close-touch.has-hover ? Palette.danger : Palette.text-muted;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Toolbar ──────────────────────────────────────────────────────
            Rectangle {
                height: 42px;
                background: Palette.surface;

                Rectangle {
                    height: 1px;
                    y: parent.height - 1px;
                    background: Palette.border;
                }

                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: space-between;

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;
                        horizontal-stretch: 1;

                        if root.current-note-id != "": Text {
                            text: root.current-note-title != "" ? root.current-note-title : root.current-note-id;
                            color: Palette.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalBox {
                        spacing: 6px;
                        alignment: end;
                        horizontal-stretch: 0;

                        // Theme toggle (dark / light)
                        theme-touch := TouchArea {
                            width: 30px;
                            height: 28px;
                            mouse-cursor: pointer;
                            clicked => { root.toggle-theme(); }

                            Rectangle {
                                background: theme-touch.has-hover ? Palette.card : transparent;
                                border-radius: 4px;
                                width: parent.width;
                                height: parent.height;

                                Text {
                                    text: root.dark-mode ? "☀" : "🌙";
                                    color: Palette.text-muted;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                        }

                        // View mode buttons — Edit / Split / Preview
                        if root.current-note-id != "": Rectangle {
                            width: mode-row.preferred-width + 6px;
                            height: 28px;
                            background: Palette.bg;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Palette.border;

                            mode-row := HorizontalBox {
                                padding: 3px;
                                spacing: 2px;
                                alignment: center;

                                edit-btn-touch := TouchArea {
                                    width: 44px;
                                    height: 22px;
                                    mouse-cursor: pointer;
                                    clicked => { root.view-mode = ViewMode.edit; }

                                    Rectangle {
                                        background: root.view-mode == ViewMode.edit ? Palette.card : (edit-btn-touch.has-hover ? Palette.card : transparent);
                                        border-radius: 3px;
                                        width: parent.width;
                                        height: parent.height;

                                        Text {
                                            text: "Edit";
                                            color: root.view-mode == ViewMode.edit ? Palette.text : Palette.text-muted;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                }

                                split-btn-touch := TouchArea {
                                    width: 44px;
                                    height: 22px;
                                    mouse-cursor: pointer;
                                    clicked => { root.view-mode = ViewMode.split; }

                                    Rectangle {
                                        background: root.view-mode == ViewMode.split ? Palette.card : (split-btn-touch.has-hover ? Palette.card : transparent);
                                        border-radius: 3px;
                                        width: parent.width;
                                        height: parent.height;

                                        Text {
                                            text: "Split";
                                            color: root.view-mode == ViewMode.split ? Palette.text : Palette.text-muted;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                }

                                prev-btn-touch := TouchArea {
                                    width: 58px;
                                    height: 22px;
                                    mouse-cursor: pointer;
                                    clicked => { root.view-mode = ViewMode.preview; }

                                    Rectangle {
                                        background: root.view-mode == ViewMode.preview ? Palette.card : (prev-btn-touch.has-hover ? Palette.card : transparent);
                                        border-radius: 3px;
                                        width: parent.width;
                                        height: parent.height;

                                        Text {
                                            text: "Preview";
                                            color: root.view-mode == ViewMode.preview ? Palette.text : Palette.text-muted;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                }
                            }
                        }

                        if root.current-note-id != "": Rectangle {
                            width: save-status-text.preferred-width + 16px;
                            height: 26px;
                            border-radius: 4px;
                            background: root.unsaved ? Palette.card : Palette.card;

                            save-status-text := Text {
                                text: root.unsaved ? "Unsaved" : "✓ Saved";
                                color: root.unsaved ? Palette.danger : Palette.success;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                            }
                        }

                        Button {
                            text: "Save";
                            height: 28px;
                            horizontal-stretch: 0;
                            enabled: root.current-note-id != "" && root.unsaved;
                            clicked => { root.save-requested(); }
                        }
                    }
                }
            }

            // ── Empty state ──────────────────────────────────────────────────
            if root.current-note-id == "": Rectangle {
                background: Palette.bg;
                vertical-stretch: 1;

                VerticalBox {
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: "No note selected";
                        color: Palette.text-muted;
                        font-size: 18px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Select a note from the sidebar, or press Ctrl+N to create one.";
                        color: Palette.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // ── Editor / Preview area ────────────────────────────────────────
            if root.current-note-id != "": HorizontalBox {
                padding: 0px;
                spacing: 0px;
                vertical-stretch: 1;

                if root.view-mode == ViewMode.edit || root.view-mode == ViewMode.split: Editor {
                    horizontal-stretch: 1;
                    content <=> root.current-note-content;
                    note-titles: root.note-titles;
                    suggestions <=> root.suggestions;
                    show-suggestions <=> root.show-suggestions;
                    content-changed(t) => { root.content-changed(t); }
                    handle-edit-key(key, ctrl, shift, alt, content, cursor, anchor) => {
                        return root.handle-edit-key(key, ctrl, shift, alt, content, cursor, anchor);
                    }
                    accept-suggestion(title, content, cursor) => {
                        return root.accept-suggestion(title, content, cursor);
                    }
                    update-suggestions(content, cursor) => {
                        root.update-suggestions(content, cursor);
                    }
                }

                if root.view-mode == ViewMode.split: Rectangle {
                    width: 1px;
                    background: Palette.border;
                    horizontal-stretch: 0;
                }

                if root.view-mode == ViewMode.split || root.view-mode == ViewMode.preview: Preview {
                    horizontal-stretch: 1;
                    blocks: root.preview-blocks;
                }
            }

            // ── Status bar ───────────────────────────────────────────────────
            Rectangle {
                height: 28px;
                background: Palette.surface;

                Rectangle {
                    height: 1px;
                    y: 0px;
                    background: Palette.border;
                }

                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: space-between;

                    Text {
                        text: root.status-message;
                        color: root.status-kind == StatusKind.error ? Palette.danger
                             : root.status-kind == StatusKind.success ? Palette.success
                             : Palette.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "Ctrl+N · New   Ctrl+S · Save   Ctrl+P · View   Ctrl+T · Theme";
                        color: Palette.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 0px;
                        overflow: elide;
                        horizontal-stretch: 0;
                    }
                }
            }
        }
    }

    // ── Keyboard shortcuts ───────────────────────────────────────────────────
    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "s") {
                root.save-requested();
                return accept;
            }
            if (event.modifiers.control && event.text == "n") {
                root.new-note-requested();
                return accept;
            }
            if (event.modifiers.control && event.text == "p") {
                root.toggle-preview();
                return accept;
            }
            if (event.modifiers.control && event.text == "t") {
                root.toggle-theme();
                return accept;
            }
            reject
        }
    }
}
