import { VerticalBox, HorizontalBox, Button, LineEdit, ListView } from "std-widgets.slint";
import { NoteItem, BacklinkItem, TreeRow, TreeRowKind, Dnd } from "types.slint";
import { Palette } from "theme.slint";

export component Sidebar inherits Rectangle {
    background: Palette.surface;
    border-width: 0px;

    in-out property <[TreeRow]> tree: [];
    in-out property <[NoteItem]> search-results: [];
    in-out property <[BacklinkItem]> backlinks: [];
    in-out property <string> current-note-id: "";
    in-out property <bool> graph-available: false;
    in property <int> note-count: 0;

    callback note-selected(string);
    callback folder-toggled(string);
    callback new-note-requested();
    callback delete-requested(string);
    callback search-changed(string);
    callback vault-change-requested();
    callback rename-requested(string, string);   // (id, new-title)
    callback note-moved(string, string);         // (id, target-folder)

    // Which list to show: tree or search results
    property <bool> searching: search-box.text != "";

    // Which note row is showing the delete confirmation
    property <string> pending-delete-id: "";

    // Which note row is in inline-rename mode (right-click activates this)
    property <string> renaming-id: "";

    VerticalBox {
        padding: 8px;
        spacing: 6px;
        vertical-stretch: 1;

        // ── Header ────────────────────────────────────────────────────────────
        HorizontalBox {
            alignment: space-between;
            height: 32px;

            Text {
                text: "Rustidian";
                color: Palette.accent;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            if !root.searching: Text {
                text: root.note-count == 0 ? "" : root.note-count + " notes";
                color: Palette.text-muted;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }

            if root.searching: Text {
                text: root.search-results.length + " results";
                color: Palette.accent;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        // ── Search box ────────────────────────────────────────────────────────
        search-box := LineEdit {
            placeholder-text: "Search notes…";
            edited(q) => { root.search-changed(q); }
        }

        // ── New note button ───────────────────────────────────────────────────
        Button {
            text: "+ New note    Ctrl+N";
            clicked => { root.new-note-requested(); }
        }

        // ── Section label ─────────────────────────────────────────────────────
        HorizontalBox {
            height: 20px;
            alignment: space-between;

            Text {
                text: root.searching ? "SEARCH RESULTS" : "NOTES";
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }

            if !root.searching && root.note-count > 0: Text {
                text: "drag to move";
                color: Palette.text-muted;
                font-size: 9px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // ── Empty states ──────────────────────────────────────────────────────
        if !root.searching && root.tree.length == 0: Rectangle {
            height: 60px;
            background: transparent;
            Text {
                text: "No notes yet.\nPress + New note to start.";
                color: Palette.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                wrap: word-wrap;
            }
        }

        if root.searching && root.search-results.length == 0: Rectangle {
            height: 48px;
            background: transparent;
            Text {
                text: "No notes match your search.";
                color: Palette.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
            }
        }

        // ── Tree / search list ────────────────────────────────────────────────
        if !root.searching: Rectangle {
            vertical-stretch: 1;
            background: transparent;
            border-width: root-drop.has-drag ? 1px : 0px;
            border-color: Palette.accent;
            border-radius: 4px;

            // Dropping anywhere that is not a folder row moves the note to the
            // vault root.  Folder rows have their own (deeper) DropArea, which
            // takes precedence over this ancestor one.
            root-drop := DropArea {
                width: parent.width;
                height: parent.height;
                can-drop(event) => {
                    Dnd.can-drop-note(event.data) ? DragAction.move : DragAction.none
                }
                dropped(event) => {
                    root.note-moved(Dnd.transfer-note(event.data), "");
                    return DragAction.move;
                }

                ListView {
                    width: parent.width;
                    height: parent.height;
                    for row in root.tree: Rectangle {
                height: row.kind == TreeRowKind.note && row.id == root.pending-delete-id ? 56px
                      : row.kind == TreeRowKind.note && row.id == root.renaming-id      ? 40px
                      : row.kind == TreeRowKind.folder                                  ? 26px
                      : 30px;
                background: row.kind == TreeRowKind.note && row.id == root.pending-delete-id
                    ? Palette.card
                    : (row.kind == TreeRowKind.note && row.id == root.current-note-id
                        ? Palette.card
                        : (row.kind == TreeRowKind.folder && row.is-selected-folder
                            ? Palette.card
                            : transparent));
                border-radius: 4px;

                // ── Folder row (drop target) ──────────────────────────────────
                if row.kind == TreeRowKind.folder: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: folder-drop.has-drag ? Palette.card : transparent;
                    border-width: folder-drop.has-drag ? 1px : 0px;
                    border-color: Palette.accent;
                    border-radius: 4px;

                    folder-drop := DropArea {
                        width: parent.width;
                        height: parent.height;
                        can-drop(event) => {
                            Dnd.can-drop-note(event.data) ? DragAction.move : DragAction.none
                        }
                        dropped(event) => {
                            root.note-moved(Dnd.transfer-note(event.data), row.id);
                            return DragAction.move;
                        }

                        folder-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { root.folder-toggled(row.id); }
                        }

                        HorizontalBox {
                            padding-left: 8px + row.depth * 14px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: row.expanded ? "▾" : "▸";
                                color: Palette.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 12px;
                            }

                            Text {
                                text: "📁 " + row.name;
                                color: Palette.text;
                                font-size: 13px;
                                font-weight: row.is-selected-folder ? 600 : 500;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                // ── Note: delete-confirm row ──────────────────────────────────
                if row.kind == TreeRowKind.note && row.id == root.pending-delete-id: VerticalBox {
                    padding: 4px;
                    spacing: 4px;
                    width: parent.width;
                    height: parent.height;

                    Text {
                        text: "Delete \"" + row.name + "\"?";
                        color: Palette.danger;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    HorizontalBox {
                        spacing: 4px;
                        Button {
                            text: "Delete";
                            height: 22px;
                            clicked => {
                                root.delete-requested(row.id);
                                root.pending-delete-id = "";
                            }
                        }
                        Button {
                            text: "Cancel";
                            height: 22px;
                            clicked => { root.pending-delete-id = ""; }
                        }
                    }
                }

                // ── Note: inline-rename row ───────────────────────────────────
                if row.kind == TreeRowKind.note && row.id == root.renaming-id && row.id != root.pending-delete-id: HorizontalBox {
                    padding-left: 8px + row.depth * 14px;
                    padding-right: 4px;
                    spacing: 4px;
                    width: parent.width;
                    height: parent.height;

                    rename-edit := LineEdit {
                        text: row.name;
                        font-size: 13px;
                        horizontal-stretch: 1;
                        height: 28px;
                        accepted(new-name) => {
                            if new-name != "" && new-name != row.name {
                                root.rename-requested(row.id, new-name);
                            }
                            root.renaming-id = "";
                        }
                    }

                    cancel-rename := TouchArea {
                        width: 22px;
                        height: 22px;
                        mouse-cursor: pointer;
                        clicked => { root.renaming-id = ""; }

                        Rectangle {
                            background: cancel-rename.has-hover ? Palette.card : transparent;
                            border-radius: 3px;
                            width: parent.width;
                            height: parent.height;
                            Text {
                                text: "✕";
                                color: Palette.text-muted;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }
                }

                // ── Note: normal row (drag source) ────────────────────────────
                if row.kind == TreeRowKind.note && row.id != root.pending-delete-id && row.id != root.renaming-id: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    drag-area := DragArea {
                        width: parent.width;
                        height: parent.height;
                        data: Dnd.note-transfer(row.id);
                        allow-move: true;
                        allow-copy: false;
                        allow-link: false;
                        // Dim the row while it is being dragged.
                        opacity: self.dragging ? 0.4 : 1.0;

                        row-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { root.note-selected(row.id); }
                            pointer-event(ev) => {
                                if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                                    root.renaming-id = row.id;
                                    root.pending-delete-id = "";
                                }
                            }
                        }

                        HorizontalBox {
                            padding-left: 8px + row.depth * 14px;
                            padding-right: 4px;
                            alignment: space-between;

                            Text {
                                text: row.name;
                                color: Palette.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            del-touch := TouchArea {
                                width: 26px;
                                height: 26px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pending-delete-id = row.id;
                                    root.renaming-id = "";
                                }

                                Rectangle {
                                    background: del-touch.has-hover ? Palette.card : transparent;
                                    border-radius: 4px;
                                    width: parent.width;
                                    height: parent.height;

                                    Text {
                                        text: "✕";
                                        color: del-touch.has-hover ? Palette.danger : Palette.text-muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                        }
                    }
                }
            }
                }
            }
        }

        if root.searching: ListView {
            vertical-stretch: 1;

            for item in root.search-results: Rectangle {
                height: 34px;
                background: item.id == root.current-note-id ? Palette.card : transparent;
                border-radius: 4px;

                result-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.note-selected(item.id); }
                }

                if result-touch.has-hover && item.id != root.current-note-id: Rectangle {
                    background: Palette.card;
                    border-radius: 4px;
                    width: parent.width;
                    height: parent.height;
                }

                HorizontalBox {
                    padding-left: 8px;
                    alignment: start;
                    Text {
                        text: item.title;
                        color: item.id == root.current-note-id ? Palette.text : Palette.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // ── Backlinks ─────────────────────────────────────────────────────────
        if root.backlinks.length > 0: VerticalBox {
            padding: 0px;
            spacing: 4px;

            Rectangle { height: 1px; background: Palette.border; }

            Text {
                text: "BACKLINKS";
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.8px;
                height: 20px;
                vertical-alignment: center;
            }

            for bl in root.backlinks: Rectangle {
                height: 30px;
                background: transparent;
                border-radius: 4px;

                bl-hover := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.note-selected(bl.id); }
                }

                if bl-hover.has-hover: Rectangle {
                    background: Palette.card;
                    border-radius: 4px;
                    width: parent.width;
                    height: parent.height;
                }

                HorizontalBox {
                    padding-left: 8px;
                    alignment: start;
                    Text {
                        text: "← " + bl.title;
                        color: Palette.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // Spacer + vault button
        Rectangle { vertical-stretch: 1; }
        Rectangle { height: 1px; background: Palette.border; }
        Button {
            text: "⚙  Change vault…";
            clicked => { root.vault-change-requested(); }
        }
    }

    // Right border
    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }
}
