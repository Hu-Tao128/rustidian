import { VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";
import { NoteItem, BacklinkItem, TreeRow, TreeRowKind, Dnd } from "types.slint";
import { Palette } from "theme.slint";
import { IconButton } from "icon_button.slint";
import { TextField } from "text_field.slint";
import { PaletteButton } from "palette_button.slint";

export component Sidebar inherits Rectangle {
    background: Palette.surface;
    border-width: 0px;

    in-out property <[TreeRow]> tree: [];
    in-out property <[NoteItem]> search-results: [];
    in-out property <[BacklinkItem]> backlinks: [];
    in-out property <string> current-note-id: "";
    in-out property <bool> graph-available: false;
    in property <int> note-count: 0;

    // Collapsed icon rail, tree sort direction and "all folders collapsed".
    in-out property <bool> collapsed: false;
    in property <bool> sort-descending: false;
    in property <bool> all-folders-collapsed: false;

    callback note-selected(string);
    callback folder-toggled(string);
    callback new-note-requested();
    callback new-folder-requested();
    callback new-note-in-folder(string);
    callback new-folder-in-folder(string);
    callback delete-requested(string);
    callback search-changed(string);
    callback vault-change-requested();
    callback rename-requested(string, string);        // (id, new-title)
    callback note-moved(string, string);              // (id, target-folder)
    callback rename-folder-requested(string, string); // (folder path, new-name)
    callback delete-folder-requested(string);         // (folder path)
    callback toggle-sort-requested();
    callback toggle-collapse-folders-requested();
    callback toggle-sidebar-requested();

    // Which list to show: tree or search results.  Kept in a root property so
    // it does not depend on the search box, which lives inside the collapsed
    // conditional block.
    in-out property <string> search-text: "";
    property <bool> searching: root.search-text != "";

    // Which note row is showing the delete confirmation
    property <string> pending-delete-id: "";

    // Which note row is in inline-rename mode (right-click activates this)
    property <string> renaming-id: "";

    // Folder row state (right-click opens the context menu; inline rename/delete
    // rows are chosen from it).
    property <string> renaming-folder-id: "";
    property <string> pending-delete-folder-id: "";

    // Commit naming edits.  Pressing Enter and clicking outside the field
    // (focus lost) both save the current text, so the user never has to hunt
    // for a confirmation button.
    function commit-note-rename(id: string, old-name: string, new-name: string) {
        if (new-name != "" && new-name != old-name) {
            root.rename-requested(id, new-name);
        }
        root.renaming-id = "";
    }

    function commit-folder-rename(id: string, old-name: string, new-name: string) {
        if (new-name != "" && new-name != old-name) {
            root.rename-folder-requested(id, new-name);
        }
        root.renaming-folder-id = "";
    }

    if !root.collapsed: VerticalBox {
        padding: 8px;
        spacing: 6px;
        vertical-stretch: 1;

        // ── Header ────────────────────────────────────────────────────────────
        HorizontalBox {
            alignment: space-between;
            height: 32px;

            Text {
                text: "Rustidian";
                color: Palette.accent;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if !root.searching: Text {
                text: root.note-count == 0 ? "" : root.note-count + " notes";
                color: Palette.text-muted;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }

            if root.searching: Text {
                text: root.search-results.length + " results";
                color: Palette.accent;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        // ── Search box ────────────────────────────────────────────────────────
        TextField {
            height: 32px;
            text <=> root.search-text;
            placeholder: "Search notes…";
            accepted(t) => { root.search-changed(t); }
            edited(t) => { root.search-changed(t); }
        }

        // ── Toolbar: new note / new folder / sort / collapse-all ──────────────
        // Compact icon buttons matching Obsidian's file-explorer header.
        HorizontalBox {
            height: 26px;
            spacing: 2px;
            alignment: center;

            IconButton {
                icon: @image-url("icons/new-note.svg");
                tip: "New note (Ctrl+N)";
                width: 28px;
                clicked => { root.new-note-requested(); }
            }

            IconButton {
                icon: @image-url("icons/new-folder.svg");
                tip: "New folder";
                width: 28px;
                clicked => { root.new-folder-requested(); }
            }

            IconButton {
                icon: root.sort-descending
                    ? @image-url("icons/sort-desc.svg")
                    : @image-url("icons/sort-asc.svg");
                tip: root.sort-descending ? "Sort: Z–A" : "Sort: A–Z";
                width: 28px;
                clicked => { root.toggle-sort-requested(); }
            }

            IconButton {
                icon: root.all-folders-collapsed
                    ? @image-url("icons/expand-all.svg")
                    : @image-url("icons/collapse-all.svg");
                tip: root.all-folders-collapsed
                    ? "Expand all folders"
                    : "Collapse all folders";
                width: 28px;
                clicked => { root.toggle-collapse-folders-requested(); }
            }
        }

        // ── Section label ─────────────────────────────────────────────────────
        HorizontalBox {
            height: 24px;
            padding-left: 2px;
            alignment: start;

            Text {
                text: root.searching ? "SEARCH RESULTS" : "NOTES";
                color: Palette.text-muted;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
        }

        // ── Empty states ──────────────────────────────────────────────────────
        if !root.searching && root.tree.length == 0: Rectangle {
            height: 60px;
            background: transparent;
            Text {
                text: "No notes yet.\nPress + New note to start.";
                color: Palette.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                wrap: word-wrap;
            }
        }

        if root.searching && root.search-results.length == 0: Rectangle {
            height: 48px;
            background: transparent;
            Text {
                text: "No notes match your search.";
                color: Palette.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
            }
        }

        // ── Tree / search list ────────────────────────────────────────────────
        if !root.searching: Rectangle {
            vertical-stretch: 1;
            background: transparent;
            border-width: root-drop.has-drag ? 1px : 0px;
            border-color: Palette.accent;
            border-radius: 4px;

            // Dropping anywhere that is not a folder row moves the note to the
            // vault root.  Folder rows have their own (deeper) DropArea, which
            // takes precedence over this ancestor one.
            root-drop := DropArea {
                width: parent.width;
                height: parent.height;
                can-drop(event) => {
                    Dnd.can-drop-note(event.data) ? DragAction.move : DragAction.none
                }
                dropped(event) => {
                    root.note-moved(Dnd.transfer-note(event.data), "");
                    return DragAction.move;
                }

                ListView {
                    width: parent.width;
                    height: parent.height;
                    for row in root.tree: Rectangle {
                height: (row.kind == TreeRowKind.note && row.id == root.pending-delete-id)
                        || (row.kind == TreeRowKind.folder && row.id == root.pending-delete-folder-id) ? 56px
                      : (row.kind == TreeRowKind.note && row.id == root.renaming-id)
                        || (row.kind == TreeRowKind.folder && row.id == root.renaming-folder-id) ? 40px
                      : row.kind == TreeRowKind.folder                                  ? 26px
                      : 30px;
                background: row.kind == TreeRowKind.note && row.id == root.pending-delete-id
                    ? Palette.card
                    : (row.kind == TreeRowKind.note && row.id == root.current-note-id
                        ? Palette.card
                        : (row.kind == TreeRowKind.folder && row.is-selected-folder
                            ? Palette.card
                            : transparent));
                border-radius: 4px;

                // ── Folder row (drop target + rename / delete) ────────────────
                if row.kind == TreeRowKind.folder: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: folder-drop.has-drag
                        || row.id == root.pending-delete-folder-id
                        || row.id == root.renaming-folder-id ? Palette.card : transparent;
                    border-width: folder-drop.has-drag ? 1px : 0px;
                    border-color: Palette.accent;
                    border-radius: 4px;

                    folder-drop := DropArea {
                        width: parent.width;
                        height: parent.height;
                        can-drop(event) => {
                            Dnd.can-drop-note(event.data) ? DragAction.move : DragAction.none
                        }
                        dropped(event) => {
                            root.note-moved(Dnd.transfer-note(event.data), row.id);
                            return DragAction.move;
                        }

                        // Inline rename — Enter or clicking outside saves,
                        // Escape cancels.  No extra "×" that looks like delete.
                        if row.id == root.renaming-folder-id: TextField {
                            x: 8px + row.depth * 14px;
                            width: parent.width - (8px + row.depth * 14px) - 4px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            font-size: 13px;
                            text: row.name;
                            init => {
                                self.grab-focus();
                                self.select-all();
                            }
                            accepted(new-name) => {
                                root.commit-folder-rename(row.id, row.name, new-name);
                            }
                            cancelled => { root.renaming-folder-id = ""; }
                            changed has-focus => {
                                if (!self.has-focus && root.renaming-folder-id == row.id) {
                                    root.commit-folder-rename(row.id, row.name, self.text);
                                }
                            }
                        }

                        // Delete confirmation
                        if row.id == root.pending-delete-folder-id: VerticalBox {
                            padding: 4px;
                            spacing: 4px;
                            width: parent.width;
                            height: parent.height;

                            Text {
                                text: "Delete folder \"" + row.name + "\" and its notes?";
                                color: Palette.danger;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            HorizontalBox {
                                spacing: 4px;
                                PaletteButton {
                                    text: "Delete";
                                    primary: true;
                                    height: 24px;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        root.delete-folder-requested(row.id);
                                        root.pending-delete-folder-id = "";
                                    }
                                }
                                PaletteButton {
                                    text: "Cancel";
                                    height: 24px;
                                    horizontal-stretch: 1;
                                    clicked => { root.pending-delete-folder-id = ""; }
                                }
                            }
                        }

                        // Normal row: click toggles; right-click opens the menu
                        if row.id != root.renaming-folder-id && row.id != root.pending-delete-folder-id: Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: transparent;

                            folder-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => { root.folder-toggled(row.id); }
                            }

                            HorizontalBox {
                                width: parent.width;
                                height: parent.height;
                                padding-left: 8px + row.depth * 14px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: start;

                                Text {
                                    text: row.expanded ? "▾" : "▸";
                                    color: Palette.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    width: 12px;
                                }

                                Text {
                                    text: row.name;
                                    color: row.is-selected-folder ? Palette.accent : Palette.text;
                                    font-size: 13px;
                                    font-weight: row.is-selected-folder ? 600 : 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }

                // ── Note: delete-confirm row ──────────────────────────────────
                if row.kind == TreeRowKind.note && row.id == root.pending-delete-id: VerticalBox {
                    padding: 4px;
                    spacing: 4px;
                    width: parent.width;
                    height: parent.height;

                    Text {
                        text: "Delete \"" + row.name + "\"?";
                        color: Palette.danger;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    HorizontalBox {
                        spacing: 4px;
                        PaletteButton {
                            text: "Delete";
                            primary: true;
                            height: 24px;
                            horizontal-stretch: 1;
                            clicked => {
                                root.delete-requested(row.id);
                                root.pending-delete-id = "";
                            }
                        }
                        PaletteButton {
                            text: "Cancel";
                            height: 24px;
                            horizontal-stretch: 1;
                            clicked => { root.pending-delete-id = ""; }
                        }
                    }
                }

                // ── Note: inline-rename row ───────────────────────────────────
                // Enter or clicking outside saves; Escape cancels.
                if row.kind == TreeRowKind.note && row.id == root.renaming-id && row.id != root.pending-delete-id: TextField {
                    x: 8px + row.depth * 14px;
                    width: parent.width - (8px + row.depth * 14px) - 4px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    font-size: 13px;
                    text: row.name;
                    init => {
                        self.grab-focus();
                        self.select-all();
                    }
                    accepted(new-name) => {
                        root.commit-note-rename(row.id, row.name, new-name);
                    }
                    cancelled => { root.renaming-id = ""; }
                    changed has-focus => {
                        if (!self.has-focus && root.renaming-id == row.id) {
                            root.commit-note-rename(row.id, row.name, self.text);
                        }
                    }
                }

                // ── Note: normal row (drag source) ────────────────────────────
                if row.kind == TreeRowKind.note && row.id != root.pending-delete-id && row.id != root.renaming-id: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    drag-area := DragArea {
                        width: parent.width;
                        height: parent.height;
                        data: Dnd.note-transfer(row.id);
                        allow-move: true;
                        allow-copy: false;
                        allow-link: false;
                        // Dim the row while it is being dragged.
                        opacity: self.dragging ? 0.4 : 1.0;

                        row-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { root.note-selected(row.id); }
                        }

                        HorizontalBox {
                            padding-left: 8px + row.depth * 14px;
                            padding-right: 6px;
                            alignment: start;

                            Text {
                                text: row.name;
                                color: Palette.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                // ── Right-click context menu ─────────────────────────────────
                // Declared last so it sits on top: it ignores left clicks (which
                // fall through to the row) and opens the menu on right click.
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Rename";
                            activated => {
                                root.pending-delete-id = "";
                                root.pending-delete-folder-id = "";
                                if row.kind == TreeRowKind.folder {
                                    root.renaming-folder-id = row.id;
                                } else {
                                    root.renaming-id = row.id;
                                }
                            }
                        }

                        if row.kind == TreeRowKind.folder: MenuItem {
                            title: "New note";
                            activated => { root.new-note-in-folder(row.id); }
                        }

                        if row.kind == TreeRowKind.folder: MenuItem {
                            title: "New folder";
                            activated => { root.new-folder-in-folder(row.id); }
                        }

                        MenuSeparator { }

                        MenuItem {
                            title: "Delete";
                            activated => {
                                root.renaming-id = "";
                                root.renaming-folder-id = "";
                                if row.kind == TreeRowKind.folder {
                                    root.pending-delete-folder-id = row.id;
                                } else {
                                    root.pending-delete-id = row.id;
                                }
                            }
                        }
                    }
                }
            }
                }
            }
        }

        if root.searching: ListView {
            vertical-stretch: 1;

            for item in root.search-results: Rectangle {
                height: 34px;
                background: item.id == root.current-note-id ? Palette.card : transparent;
                border-radius: 4px;

                result-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.note-selected(item.id); }
                }

                if result-touch.has-hover && item.id != root.current-note-id: Rectangle {
                    background: Palette.card;
                    border-radius: 4px;
                    width: parent.width;
                    height: parent.height;
                }

                HorizontalBox {
                    padding-left: 8px;
                    alignment: start;
                    Text {
                        text: item.title;
                        color: item.id == root.current-note-id ? Palette.text : Palette.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // ── Backlinks ─────────────────────────────────────────────────────────
        if root.backlinks.length > 0: VerticalBox {
            padding: 0px;
            spacing: 4px;

            Rectangle { height: 1px; background: Palette.border; }

            Text {
                text: "BACKLINKS";
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.8px;
                height: 20px;
                vertical-alignment: center;
            }

            for bl in root.backlinks: Rectangle {
                height: 30px;
                background: transparent;
                border-radius: 4px;

                bl-hover := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.note-selected(bl.id); }
                }

                if bl-hover.has-hover: Rectangle {
                    background: Palette.card;
                    border-radius: 4px;
                    width: parent.width;
                    height: parent.height;
                }

                HorizontalBox {
                    padding-left: 8px;
                    alignment: start;
                    Text {
                        text: "← " + bl.title;
                        color: Palette.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // Spacer + vault button
        Rectangle { height: 1px; background: Palette.border; }

        Rectangle {
            height: 30px;
            border-radius: 4px;
            background: vault-touch.has-hover ? Palette.card : transparent;

            vault-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.vault-change-requested(); }
            }

            HorizontalBox {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                alignment: start;

                Image {
                    source: @image-url("icons/settings.svg");
                    width: 16px;
                    height: 16px;
                    vertical-alignment: center;
                    colorize: Palette.text;
                }

                Text {
                    text: "Change vault…";
                    color: Palette.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }

    // ── Collapsed icon rail ──────────────────────────────────────────────────
    if root.collapsed: VerticalBox {
        padding: 6px;
        spacing: 6px;
        alignment: start;

        IconButton {
            icon: @image-url("icons/panel-left.svg");
            tip: "Expand sidebar";
            height: 28px;
            clicked => { root.toggle-sidebar-requested(); }
        }

        Rectangle { height: 1px; background: Palette.border; }

        IconButton {
            icon: @image-url("icons/new-note.svg");
            tip: "New note (Ctrl+N)";
            height: 28px;
            clicked => { root.new-note-requested(); }
        }

        IconButton {
            icon: @image-url("icons/new-folder.svg");
            tip: "New folder";
            height: 28px;
            clicked => { root.new-folder-requested(); }
        }

        IconButton {
            icon: root.sort-descending
                ? @image-url("icons/sort-desc.svg")
                : @image-url("icons/sort-asc.svg");
            tip: root.sort-descending ? "Sort: Z–A" : "Sort: A–Z";
            height: 28px;
            clicked => { root.toggle-sort-requested(); }
        }

        IconButton {
            icon: root.all-folders-collapsed
                ? @image-url("icons/expand-all.svg")
                : @image-url("icons/collapse-all.svg");
            tip: root.all-folders-collapsed
                ? "Expand all folders"
                : "Collapse all folders";
            height: 28px;
            clicked => { root.toggle-collapse-folders-requested(); }
        }

        Rectangle { vertical-stretch: 1; }

        IconButton {
            icon: @image-url("icons/settings.svg");
            tip: "Change vault…";
            height: 28px;
            clicked => { root.vault-change-requested(); }
        }
    }

    // Right border
    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }
}
